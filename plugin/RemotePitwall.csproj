<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RemotePitwall</AssemblyName>
    <SimHubDir Condition="'$(SimHubDir)' == ''">C:\Program Files (x86)\SimHub</SimHubDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SimHub.Plugins" HintPath="$(SimHubDir)\SimHub.Plugins.dll" Private="false" />
    <Reference Include="GameReaderCommon" HintPath="$(SimHubDir)\GameReaderCommon.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(SimHubDir)\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>
</Project>
